# Vorlage fuer /opt/gebimo/.env
#
#   cp grundstueck-crawler/deploy/env.beispiel /opt/gebimo/.env
#   chmod 600 /opt/gebimo/.env
#
# Diese Datei gehoert NIE ins Repository. .gitignore deckt .env bereits ab --
# aber die Vorlage hier enthaelt deshalb auch keine echten Werte.

# ---------------------------------------------------------------------
# Domain, auf die der Dienst hoert. Muss per DNS auf die oeffentliche IP
# der VM zeigen, sonst bekommt Caddy kein Zertifikat.
#
#   Eigene Domain:   api.gebimo.ch
#   Ohne Domain:     <IP-mit-Bindestrichen>.sslip.io
#                    z. B. 152-67-1-2.sslip.io
# ---------------------------------------------------------------------
DOMAIN=api.beispiel.ch

# ---------------------------------------------------------------------
# Schluessel fuer Modul 2 (Auswertung der Bau- und Nutzungsordnung).
# Kostenlos ohne Kreditkarte: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Gemeinsames Geheimnis zwischen Cloudflare Pages und diesem Dienst.
#
# Ohne diesen Riegel kann jeder im Internet /analyze aufrufen -- und jeder
# Aufruf kostet 129 Sekunden Rechenzeit und einen Gemini-Aufruf aus DEINEM
# Kontingent.
#
# Erzeugen mit:  openssl rand -base64 32
#
# Derselbe Wert muss in Cloudflare Pages als Umgebungsvariable
# BACKEND_SCHLUESSEL hinterlegt werden.
# ---------------------------------------------------------------------
ZUGANGSSCHLUESSEL=
